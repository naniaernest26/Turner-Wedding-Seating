        function searchGuest() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const container = document.getElementById('resultsContainer');
            const noMatch = document.getElementById('noMatch');
            const clearBtn = document.getElementById('clearBtn');
            const initialState = document.getElementById('initialState');

            container.innerHTML = '';

            if (query === '') {
                noMatch.classList.add('hidden');
                clearBtn.classList.add('hidden');
                initialState.classList.remove('hidden');
                return;
            }

            clearBtn.classList.remove('hidden');
            initialState.classList.add('hidden');

            const matches = guests.filter(g => g.name.toLowerCase().includes(query));

            if (matches.length === 0) {
                noMatch.classList.remove('hidden');
            } else {
                noMatch.classList.add('hidden');
                matches.forEach(g => {
                    const item = document.createElement('div');
                    item.className = 'flex justify-between items-center bg-amber-50/70 border border-amber-200/50 p-3.5 rounded-2xl shadow-sm hover:border-amber-400 transition-all';
                    item.innerHTML = `
                        <span class="font-medium text-slate-800 text-sm sm:text-base">${g.name}</span>
                        <span class="badge-gold font-semibold text-xs sm:text-sm px-3 py-1.5 rounded-full shadow-sm whitespace-nowrap ml-3">
                            ${g.table}
                        </span>
                    `;
                    container.appendChild(item);
                });
            }
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            searchGuest();
            document.getElementById('searchInput').focus();
